#usda 1.0
(
    defaultPrim = "World"
    endTimeCode = 20
    metersPerUnit = 1000
    startTimeCode = 1
    timeCodesPerSecond = 4
    upAxis = "Z"
)

def Xform "World" (
    kind = "assembly"
    variants = {
        string sun_case = "sun_slant"
    }
    prepend variantSets = "sun_case"
)
{
    def Xform "Week2Scene" (
        prepend references = @../week2/clouds_move.usda@
    )
    {
        over "MovingCloudSystem" (
            variants = {
                string motion_mode = "static_cloud"
            }
        )
        {
            token visibility = "invisible"
        }
    }

    def Scope "Materials" (
        kind = "group"
    )
    {
        def Material "CloudRadianceMaterial"
        {
            token outputs:surface.connect = </World/Materials/CloudRadianceMaterial/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.93, 1)
                float inputs:metallic = 0
                float inputs:opacity = 0.9
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "CloudShadowMaterial"
        {
            token outputs:surface.connect = </World/Materials/CloudShadowMaterial/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.004, 0.006, 0.004)
                float inputs:metallic = 0
                float inputs:opacity = 0.75
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }
    }

    def Xform "Radiance" (
        kind = "group"
    )
