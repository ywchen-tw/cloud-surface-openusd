def Xform "World" (
    kind = "assembly"
)
{
    def "Materials"
    {
        def Material "OpenWater"
        {
            token outputs:surface.connect = </World/Materials/OpenWater/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.015, 0.055, 0.11)
                float inputs:roughness = 0.55
                float inputs:specular = 0.02
                token outputs:surface
            }
        }

        def Material "Floe"
        {
            token outputs:surface.connect = </World/Materials/Floe/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7, 0.76, 0.8)
                float inputs:roughness = 0.9
                float inputs:specular = 0.02
                token outputs:surface
            }
        }

        def Material "SeaIceSheet"
        {
            token outputs:surface.connect = </World/Materials/SeaIceSheet/PreviewSurface.outputs:surface>

