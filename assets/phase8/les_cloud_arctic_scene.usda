#usda 1.0
(
    defaultPrim = "World"
    endTimeCode = 20
    framesPerSecond = 8
    metersPerUnit = 1
    startTimeCode = 1
    timeCodesPerSecond = 8
    upAxis = "Z"
)

def Xform "World" (
    kind = "assembly"
)
{
    def "Materials"
    {
        def Material "ArcticAlbedo"
        {
            token outputs:surface.connect = </World/Materials/ArcticAlbedo/PreviewSurface.outputs:surface>

            def Shader "StReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "AlbedoTex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../../data/processed/arctic_albedo_texture.png@
                float2 inputs:st.connect = </World/Materials/ArcticAlbedo/StReader.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                color3f outputs:rgb
            }

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/Materials/ArcticAlbedo/AlbedoTex.outputs:rgb>
                float inputs:roughness = 0.7
                float inputs:specular = 0.02
                token outputs:surface
            }
        }
    }

    def "Surface"
    {
        def Mesh "ArcticSurface" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            float3[] extent = [(-6400, -6400, 0), (12800, 12800, 0)]
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [0, 1, 2, 3]
            rel material:binding = </World/Materials/ArcticAlbedo>
            point3f[] points = [(-6400, -6400, 0), (12800, -6400, 0), (12800, 12800, 0), (-6400, 12800, 0)]
            texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
                interpolation = "varying"
            )
        }
    }

    def Xform "CloudVolume"
    {
        def Xform "Tile_0_0"
        {
            double3 xformOp:translate = (-6400, -6400, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Volume "Volume" (
                customData = {
                    double asymmetry_g = 0.85
                    string source = "7SEAS SAM-LES cloudiest 64x64 tile via src/cloud_field.py"
                    double ssa = 0.999999
                    string units = "extinction_per_meter"
                }
            )
            {
                float3[] extent = [(0, 0, 0), (6400, 6400, 2560)]
                custom rel field:density = </World/CloudVolume/Tile_0_0/Volume/Density>

                def OpenVDBAsset "Density"
                {
                    token fieldClass = "fogVolume"
                    token fieldName = "density"
                    asset filePath = @../week7/vdbs/cloud_density.vdb@
                }
            }
        }

