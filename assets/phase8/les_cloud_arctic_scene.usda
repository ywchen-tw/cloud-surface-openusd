#usda 1.0
(
    defaultPrim = "World"
    endTimeCode = 200
    framesPerSecond = 8
    metersPerUnit = 1
    startTimeCode = 1
    timeCodesPerSecond = 8
    upAxis = "Z"
)

def Xform "World" (
    kind = "assembly"
)
{
    def "Materials"
    {
        def Material "ArcticAlbedo"
        {
            token outputs:surface.connect = </World/Materials/ArcticAlbedo/PreviewSurface.outputs:surface>

            def Shader "StReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "AlbedoTex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../../data/processed/arctic_albedo_texture.png@
                float2 inputs:st.connect = </World/Materials/ArcticAlbedo/StReader.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                color3f outputs:rgb
            }

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/Materials/ArcticAlbedo/AlbedoTex.outputs:rgb>
                float inputs:roughness = 0.7
                float inputs:specular = 0.02
                token outputs:surface
            }
        }
    }

    def "Surface"
    {
        def Mesh "ArcticSurface" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            float3[] extent = [(-25600, -25600, 0), (38400, 38400, 0)]
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [0, 1, 2, 3]
            rel material:binding = </World/Materials/ArcticAlbedo>
            point3f[] points = [(-25600, -25600, 0), (38400, -25600, 0), (38400, 38400, 0), (-25600, 38400, 0)]
            texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
                interpolation = "varying"
            )
        }
    }

    def Xform "CloudVolume"
    {
        def Volume "Volume"
        {
            float3[] extent = [(-16000, -16000, 0), (32000, 32000, 2560)]
            custom rel field:density = </World/CloudVolume/Volume/Density>

            def OpenVDBAsset "Density"
            {
                token fieldClass = "fogVolume"
                token fieldName = "density"
                asset filePath = @../week7/vdbs/cloud_density_full48km.vdb@
            }
        }
    }

    def "Lighting"
    {
        def DistantLight "Sun"
        {
            float inputs:angle = 0.53
            color3f inputs:color = (1, 0.96, 0.9)
            float inputs:intensity = 3000
            float xformOp:rotateX = 55
            float xformOp:rotateZ = 140
            uniform token[] xformOpOrder = ["xformOp:rotateZ", "xformOp:rotateX"]
        }
    }

