            def Volume "Volume" (
                customData = {
                    double asymmetry_g = 0.85
                    string source = "7SEAS SAM-LES cloudiest 64x64 tile via src/cloud_field.py"
                    double ssa = 0.999999
                    string units = "extinction_per_meter"
                }
            )
            {
                float3[] extent = [(0, 0, 0), (6400, 6400, 2560)]
                custom rel field:density = </World/CloudVolume/Tile_0_0/Volume/Density>

