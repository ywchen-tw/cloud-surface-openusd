#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World" (
    customData = {
        string renderNote = "Cycles route: sbatch repro/curc/render_week7_cycles.sbatch assets/phase8/les_cloud_scene.usda 1 1 256; nadir validation render uses --camera NadirCamera at SZA 30 deg."
    }
    kind = "assembly"
)
{
    def "Surface"
    {
        def Mesh "Ocean" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            float3[] extent = [(0, 0, 0), (6400, 6400, 0)]
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [0, 1, 2, 3]
            rel material:binding = </World/Materials/OceanDark>
            point3f[] points = [(0, 0, 0), (6400, 0, 0), (6400, 6400, 0), (0, 6400, 0)]
            color3f[] primvars:displayColor = [(0.02, 0.09, 0.17)]
        }
    }

    def "Materials"
    {
        def Material "OceanDark"
        {
            token outputs:surface.connect = </World/Materials/OceanDark/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.02, 0.09, 0.17)
                float inputs:roughness = 0.9
                float inputs:specular = 0.02
                token outputs:surface
            }
        }
    }

    def Xform "CloudVolume"
    {
        def Xform "Tile_1_1"
        {
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Volume "Volume" (
                customData = {
                    double asymmetry_g = 0.85
                    string source = "7SEAS SAM-LES cloudiest 64x64 tile via src/cloud_field.py"
                    double ssa = 0.999999
                    string units = "extinction_per_meter"
                }
            )
            {
                float3[] extent = [(0, 0, 0), (6400, 6400, 2560)]
                custom rel field:density = </World/CloudVolume/Tile_1_1/Volume/Density>

                def OpenVDBAsset "Density"
                {
                    token fieldClass = "fogVolume"
                    token fieldName = "density"
                    asset filePath = @../week7/vdbs/cloud_density.vdb@
                }
            }
        }
    }

    def "Lighting"
    {
        def DistantLight "Sun"
        {
            float inputs:angle = 0.53
            color3f inputs:color = (1, 0.985, 0.95)
            float inputs:intensity = 2500
            float xformOp:rotateX = 30
            float xformOp:rotateZ = 140
            uniform token[] xformOpOrder = ["xformOp:rotateZ", "xformOp:rotateX"]
        }
    }

    def "Camera"
    {
        def Camera "MainCamera"
        {
            float2 clippingRange = (10, 60000)
            float focalLength = 28
            matrix4d xformOp:transform = ( (0.7961621941231025, -0.605083267533558, 0, 0), (0.1769068986020671, 0.23277223500271985, 0.9563059321361742, 0), (-0.5786447181786811, -0.7613746291824751, 0.2923678576060704, 0), (-2880, -4800, 4096, 1) )
            uniform token[] xformOpOrder = ["xformOp:transform"]
        }

        def Camera "NadirCamera"
        {
            float2 clippingRange = (100, 30000)
            float horizontalAperture = 6400
            token projection = "orthographic"
            float verticalAperture = 6400
            double3 xformOp:translate = (3200, 3200, 8560)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}

