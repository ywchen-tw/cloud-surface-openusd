        kind = "group"
    )
    {
        def DistantLight "PolarLowSun"
        {
            float inputs:angle = 0.45
            color3f inputs:color = (1, 0.86, 0.68)
            float inputs:intensity = 650
            float3 xformOp:rotateXYZ = (-34, 0, -38)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }

        def DistantLight "ZenithSun"
        {
            float inputs:angle = 0.35
            color3f inputs:color = (1, 0.96, 0.88)
            float inputs:intensity = 520
            float3 xformOp:rotateXYZ = (-80, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }

        def DomeLight "SkyFill"
        {
            color3f inputs:color = (0.46, 0.54, 0.64)
            float inputs:intensity = 8
        }
    }

