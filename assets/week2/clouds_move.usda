#usda 1.0
(
    defaultPrim = "World"
    endTimeCode = 20
    metersPerUnit = 1000
    startTimeCode = 1
    timeCodesPerSecond = 4
    upAxis = "Z"
)

def Xform "World" (
    kind = "assembly"
)
{
    def Xform "Environment" (
        prepend references = @../week1/environment.usda@
    )
    {
        over "Clouds" (
            variants = {
                string cloud_visibility = "hidden"
            }
        )
        {
        }
    }

    def Scope "Materials" (
        kind = "group"
    )
    {
        def Material "AnimatedCloudMaterial"
        {
            token outputs:surface.connect = </World/Materials/AnimatedCloudMaterial/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.92, 0.95, 1)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "CloudShadowMaterial"
        {
            token outputs:surface.connect = </World/Materials/CloudShadowMaterial/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.004, 0.006, 0.004)
                float inputs:metallic = 0
                float inputs:opacity = 0.72
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }
    }

    def Xform "MovingCloudSystem" (
        kind = "group"
        variants = {
            string motion_mode = "manual_transform"
        }
        prepend variantSets = "motion_mode"
    )
    {
        variantSet "motion_mode" = {
            "advected_points" (
                kind = "group"
